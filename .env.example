# Copy to `.env` before running.  `.env` is gitignored.

# --- image tags ---------------------------------------------------------------
# Milvus 3.0.0 GA (published 2026-07-29).  To move to a different tag, change
# this line and `docker compose up -d --force-recreate milvus`.  Note the same
# default is repeated in docker-compose.yml and webapp/environment.py as a
# fallback for when this file is absent -- keep the three in sync.
MILVUS_TAG=v3.0.0
ES_TAG=9.4.3

# --- data volume location (optional) -----------------------------------------
DOCKER_VOLUME_DIRECTORY=.

# --- host ports (optional) ----------------------------------------------------
# In-container traffic always uses the internal ports (milvus:19530, es:9200);
# these only change what the HOST binds. Override when another Milvus or ES
# stack on the machine already holds a default port.
#MILVUS_PORT=19530
#MILVUS_METRICS_PORT=9091
#ES_PORT=9200
#DEMO_PORT=8080
